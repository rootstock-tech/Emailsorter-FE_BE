# Groq API key used for classification and draft replies.
GROQ_API_KEY=

# Secret used to sign session cookies. Set a long random value in production
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`). If left
# empty, the app generates a temporary random secret at startup and sessions
# reset on every restart.
SESSION_SECRET=

# Set to "true" in production so session cookies are only sent over HTTPS.
# Leave "false" (or unset) for local http://localhost development.
SESSION_HTTPS_ONLY=false

# OAuth2 redirect URI for the web login. Must match an authorized redirect URI
# on the web client in Google Cloud. Change to your public callback URL in
# production (defaults to the local dev URL if unset).
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
