# Groq API key used for classification and draft replies.
GROQ_API_KEY=

# Set to production on the hosted service to enable fail-fast security checks.
APP_ENV=development

# Secret used to sign session cookies. Set a long random value in production
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`). If left
# empty, the app generates a temporary random secret at startup and sessions
# reset on every restart.
SESSION_SECRET=

# Set to "true" in production so session cookies are only sent over HTTPS.
# Leave "false" (or unset) for local http://localhost development.
SESSION_HTTPS_ONLY=false

# OAuth2 redirect URI for the web login. Must match an authorized redirect URI
# on the web client in Google Cloud. Change to your public callback URL in
# production (defaults to the local dev URL if unset).
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Real-time Gmail push (optional). Full Pub/Sub topic name that Gmail publishes
# mailbox changes to. When set, the app registers a watch per user and the
# /api/gmail/push webhook triages new mail as it arrives. Leave empty to keep
# push off (manual + scheduled triage still work).
# Example: projects/your-project/topics/gmail-triage
GMAIL_PUBSUB_TOPIC=

# Required when Gmail push is enabled. The Pub/Sub push subscription must call
# the endpoint as /api/gmail/push?token=<value>.
PUSH_AUTH_TOKEN=

# Shared secret sent by the Gmail add-on in X-Addon-Secret. Set the same value
# as ADDON_SECRET in Apps Script Properties.
ADDON_SHARED_SECRET=

# Hosted deployments normally need HOST=0.0.0.0 and inject their own PORT.
HOST=127.0.0.1
PORT=8000

# Put this on a persistent mounted volume in production.
APP_DB_PATH=app.db

# Opt in to automatic self-reminder emails for unread high-priority mail older
# than 24 hours and deadlines due within 7 days.
REMINDER_EMAILS_ENABLED=false
